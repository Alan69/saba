# PostgreSQL
POSTGRES_USER=saba
POSTGRES_PASSWORD=saba_dev_password
POSTGRES_DB=saba

# API
JWT_SECRET=change-me-in-production
# локальный порт 5433, чтобы не конфликтовать с возможным локальным Postgres
DATABASE_URL=postgresql://saba:saba_dev_password@localhost:5433/saba
REDIS_URL=redis://localhost:6379

# WhatsApp Cloud API (Meta). Пока пусто — напоминания уходят в лог,
# а OTP клиентского портала возвращается в ответе как dev-стаб.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_OTP=saba_otp
WHATSAPP_TEMPLATE_REMINDER=saba_reminder
WHATSAPP_LANG=ru
